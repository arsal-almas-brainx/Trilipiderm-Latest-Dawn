{%- style -%}
  .tile-slider-section-{{ section.id }} {
    background-color: {{ section.settings.background_color }};
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px 0;
  }

  .row-tiles-{{ section.id }} {
    display: flex;
    flex-wrap: nowrap;
    overflow-x: auto;
    gap: 36px;
    padding: 0 6%;
    cursor: default;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
    width: 93%;
  }

  .row-tiles-{{ section.id }}::-webkit-scrollbar {
    display: none;
  }

  .row-tiles-{{ section.id }}.dragging {
    cursor: pointer;
  }

  .tile-{{ section.id }} {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    flex-shrink: 0;
    cursor: pointer;
  }

  .tile-{{ section.id }} .image-container-{{ section.id }} {
    height: 90px;
  }

  .tile-{{ section.id }} .image-container-{{ section.id }} svg {
    border: 1px solid #AAAAAA;
    display: block;
  }

  .tile-{{ section.id }} .tile-image-{{ section.id }} {
    height: 100%;
    width: 100%;
    object-fit: cover;
    display: block;
  }

  .tile-{{ section.id }} .tile-text-{{ section.id }} {
    text-align: center;
    font-size: {{ section.settings.font_size }}px;
    color: {{ section.settings.text_color }};
    margin-top: 8px;
    margin-bottom: 0;
    letter-spacing: 0;
  }

  @media screen and (max-width: 767px) {
    .row-tiles-{{ section.id }} {
      scrollbar-width: thin;
      scrollbar-color: #4A7FA5 #DBDBDB;
      -ms-overflow-style: none;
      padding: 0 6%;
    }

    .row-tiles-{{ section.id }}::-webkit-scrollbar {
      display: block;
      height: 1px;
    }

    .row-tiles-{{ section.id }}::-webkit-scrollbar-track {
      background: #DBDBDB;
      border-radius: 2px;
      margin: 0 6%;
    }

    .row-tiles-{{ section.id }}::-webkit-scrollbar-thumb {
      background: #4A7FA5;
      border-radius: 2px;
    }
    .row-tiles-{{ section.id }} {
      gap: 16px;
      width: 100%;
      padding-bottom: 7%;
    }
  }
{%- endstyle -%}

<div class="tile-slider-section-{{ section.id }}" data-section-id="{{ section.id }}">
  <div class="row-tiles-{{ section.id }}" id="tile-slider-{{ section.id }}">
    {%- for block in section.blocks -%}
