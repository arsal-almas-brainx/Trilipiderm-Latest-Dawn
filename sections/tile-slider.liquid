.9982 34.8294 41.9423C34.698 41.8864 34.5786 41.8042 34.4782 41.7004C34.3777 41.5967 34.2981 41.4735 34.2439 41.3379C34.1897 41.2023 34.162 41.057 34.1624 40.9103V33.0976C34.162 32.9509 34.1897 32.8056 34.2439 32.67C34.2981 32.5343 34.3777 32.4111 34.4782 32.3074C34.5786 32.2037 34.698 32.1215 34.8294 32.0656C34.9608 32.0096 35.1015 31.9811 35.2437 31.9815H42.8122C42.9543 31.9811 43.0951 32.0096 43.2265 32.0656C43.3578 32.1215 43.4772 32.2037 43.5777 32.3074C43.6782 32.4111 43.7578 32.5343 43.812 32.67C43.8662 32.8056 43.8938 32.9509 43.8934 33.0976Z"
                fill="#707070" />
              <rect x="0.5" y="0.5" width="93" height="89" stroke="#AAAAAA" />
            </svg>
          </div>
          <p class="tile-text-{{ section.id }}" style="font-weight: {{ block.settings.font_weight }};">
            {{ block.settings.text }}
          </p>
        </a>
      {%- elsif block.type == 'image_tile' -%}
        <a class="tile-{{ section.id }}" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>
          <div class="image-container-{{ section.id }}">
            {%- if block.settings.image != blank -%}
              <img
                class="tile-image-{{ section.id }}"
                src="{{ block.settings.image | image_url: width: 214 }}"
                alt="{{ block.settings.image.alt | escape }}"
                width="107"
                height="90"
                loading="lazy"
                draggable="false"
              >
            {%- else -%}
              {%- assign placeholder_class = 'tile-image-' | append: section.id -%}
              {{ 'image' | placeholder_svg_tag: placeholder_class }}
            {%- endif -%}
          </div>
          <p class="tile-text-{{ section.id }}" style="font-weight: {{ block.settings.font_weight }};">
            {{ block.settings.text }}
          </p>
        </a>
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>

<script>
  (function () {
    const slider = document.getElementById('tile-slider-{{ section.id }}');
    if (!slider) return;

    let isDown = false;
    let startX;
    let scrollLeft;
    let hasMoved = false;

    slider.addEventListener('mousedown', function (e) {
      isDown = true;
      hasMoved = false;
      startX = e.pageX - slider.offsetLeft;
      scrollLeft = slider.scrollLeft;
      e.preventDefault();
    });

    slider.addEventListener('mouseleave', function () {
      isDown = false;
    });

    slider.addEventListener('mouseup', function () {
      isDown = false;
    });

    slider.addEventListener('mousemove', function (e) {
      if (!isDown) return;
      e.preventDefault();
      const x = e.pageX - slider.offsetLeft;
      const walk = (x - startX) * 1.5;
      if (Math.abs(walk) > 5) {
        hasMoved = true;
      }
      slider.scrollLeft = scrollLeft - walk;
    });

    // Prevent link click after drag
    slider.addEventListener(
      'click',
      function (e) {
        if (hasMoved) {
          e.preventDefault();
          e.stopPropagation();
        }
      },
      true
    );
  })();
</script>

{% schema %}
{
  "name": "Tile Slider",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#FAF6F0"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "font_size",
      "min": 10,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Font Size",
      "default": 14
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top Padding",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 20
    }
  ],
  "blocks": [
    {
      "type": "svg_tile",
      "name": "SVG Tile (View All)",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "VIEW ALL"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "select",
          "id": "font_weight",
          "label": "Font Weight",
          "options": [
            { "value": "300", "label": "Light" },
            { "value": "400", "label": "Normal" },
            { "value": "500", "label": "Medium" },
            { "value": "600", "label": "Semi Bold" },
            { "value": "700", "label": "Bold" }
          ],
          "default": "400"
        }
      ]
    },
    {
      "type": "image_tile",
      "name": "Image Tile",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "THE GLOW EDIT"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "select",
          "id": "font_weight",
          "label": "Font Weight",
          "options": [
            { "value": "300", "label": "Light" },
            { "value": "400", "label": "Normal" },
            { "value": "500", "label": "Medium" },
            { "value": "600", "label": "Semi Bold" },
            { "value": "700", "label": "Bold" }
          ],
          "default": "400"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Tile Slider",
      "blocks": [
        {
          "type": "svg_tile",
          "settings": {
            "text": "VIEW ALL",
            "link": ""
          }
        },
        {
          "type": "image_tile",
          "settings": {
            "text": "THE GLOW EDIT"
          }
        }
      ]
    }
  ]
}
{% endschema %}
