{%- style -%}
  .section-container-{{ section.id }} {
    position: relative;
    display: flex;
    align-items: center;
    background-color: {{ section.settings.background_color }};
    width: 100%;
  }

  .section-multicolumn-{{ section.id }} {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    width: 100%;
    height: 65px;
    padding: 0 6%;
    padding-top: 10px;
    gap: 20.3rem;
    overflow-x: hidden;
    scroll-behavior: smooth;
  }

  .column-{{ section.id }} {
    display: flex;
    align-items: center;
    color: {{ section.settings.text_color }};
    gap: 5px;
    white-space: nowrap;
  }

  .column-{{ section.id }} .icon-text {
    font-size: {{ section.settings.font_size }}px;
    color: {{ section.settings.text_color }};
    font-weight: 300;
    align-self: start;
    letter-spacing: 0;
  }

  .slider-nav-{{ section.id }} {
    display: none;
    position: absolute;
    background: none;
    border: none;
    color: white;
    font-size: 20px;
    cursor: pointer;
    z-index: 100;
    padding: 10px;
    pointer-events: auto;
  }

  .slider-nav-{{ section.id }}.prev { left: 5px; }
  .slider-nav-{{ section.id }}.next { right: 5px; }

  .svg-icon-{{ section.id }} svg {
    width: 34px;
    height: 34px;
  }

  @media screen and (max-width: 992px) {
    .section-container-{{ section.id }} {
      height: 70px;
    }

    .section-multicolumn-{{ section.id }} {
      display: flex;
      flex-direction: row;
      overflow-x: scroll;
      overflow-y: hidden;
      scroll-snap-type: x mandatory;
      padding: 0 50px;
      width: 100%;
      height: 100%;
      -webkit-overflow-scrolling: touch;
    }

    .column-{{ section.id }} {
      min-width: 100%;
      flex-shrink: 0;
      scroll-snap-align: center;
      justify-content: center;
    }

    .slider-nav-{{ section.id }} {
      display: block;
      border-radius: 50%;
      width: 40px;
      height: 40px;
      top: 50%;
      transform: translateY(-50%);
    }
    .slider-nav-{{ section.id }}.prev { left: 10px; }
    .slider-nav-{{ section.id }}.next { right: 10px; }
    .column-{{ section.id }} .icon-text {
      align-self: center;
    }
  }
{%- endstyle -%}

