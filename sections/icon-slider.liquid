<script>
  (function() {
    const container = document.querySelector('.section-container-{{ section.id }}[data-section-id="{{ section.id }}"]');
    if (!container) return;
    
    const slider = document.getElementById('slider-{{ section.id }}');
    if (!slider) return;
    
    const buttons = container.querySelectorAll('.slider-nav-{{ section.id }}');
    
    buttons.forEach(button => {
      button.addEventListener('click', function(e) {
        e.preventDefault();
        const direction = parseInt(this.getAttribute('data-direction'));
        const scrollAmount = slider.clientWidth;
        const currentScroll = slider.scrollLeft;
        const targetScroll = currentScroll + (direction * scrollAmount);
        
        slider.scrollTo({
          left: targetScroll,
          behavior: 'smooth'
        });
      });
      
      // Add touch support for mobile
      button.addEventListener('touchend', function(e) {
        e.preventDefault();
        const direction = parseInt(this.getAttribute('data-direction'));
        const scrollAmount = slider.clientWidth;
        const currentScroll = slider.scrollLeft;
        const targetScroll = currentScroll + (direction * scrollAmount);
        
        slider.scrollTo({
          left: targetScroll,
          behavior: 'smooth'
        });
      });
    });
  })();
</script>

