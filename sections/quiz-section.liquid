{{ 'quiz-section.css' | asset_url | stylesheet_tag }}

<script src="{{ 'quiz-section.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<quiz-section class="quiz-section-wrapper section-{{ section.id }}-padding">
  <div class="quiz-section">
    <div class="quiz-text-container">
      <p class="quiz-txt-1">{{ section.settings.heading_text }}</p>
      <div class="quiz-txt-2">
        {{ section.settings.prefix_text }}
        <span class="quiz-dropdown-wrapper quiz-dropdown-1-wrapper">
          <div class="quiz-dropdown-trigger" data-dropdown-trigger="1">
            <div class="quiz-dropdown-container">
              <p class="quiz-dropdown-txt" data-dropdown-selected="1">{{ section.settings.dropdown1_placeholder }}</p>
              <svg class="quiz-dropdown-arrow" width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M6 9L12 15L18 9" stroke="#1B2D4F" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
          </div>
          <div class="quiz-dropdown-list" data-dropdown-list="1">
            {%- assign dropdown1_items = section.settings.dropdown1_options | split: ',' -%}
            {%- for item in dropdown1_items -%}
              <div class="quiz-dropdown-item" data-dropdown-value="{{ item | strip }}" data-dropdown-target="1">{{ item | strip }}</div>
            {%- endfor -%}
          </div>
        </span>
        {{ section.settings.middle_text }}
        <span class="quiz-dropdown-wrapper quiz-dropdown-2-wrapper">
          <div class="quiz-dropdown-trigger" data-dropdown-trigger="2">
            <div class="quiz-dropdown-container">
              <p class="quiz-dropdown-txt" data-dropdown-selected="2">{{ section.settings.dropdown2_placeholder }}</p>
              <svg class="quiz-dropdown-arrow" width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M6 9L12 15L18 9" stroke="#1B2D4F" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
          </div>
          <div class="quiz-dropdown-list" data-dropdown-list="2">
            {%- assign dropdown2_items = section.settings.dropdown2_options | split: ',' -%}
            {%- for item in dropdown2_items -%}
              <div class="quiz-dropdown-item" data-dropdown-value="{{ item | strip }}" data-dropdown-target="2">{{ item | strip }}</div>
            {%- endfor -%}
          </div>
        </span>
      </div>
      <div class="quiz-button-container">
        <a href="{{ section.settings.button_link }}" class="quiz-start-btn">{{ section.settings.button_text }}</a>
        {%- if section.settings.mobile_image != blank -%}
          <div class="quiz-btn-image-container">
            <img class="quiz-btn-image" src="{{ section.settings.mobile_image | image_url: width: 500 }}" alt="" width="231" height="190" loading="lazy">
          </div>
        {%- endif -%}
      </div>
    </div>
    {%- if section.settings.right_image != blank -%}
      <div class="quiz-image-container">
        <img class="quiz-right-image" src="{{ section.settings.right_image | image_url: width: 800 }}" alt="" width="800" height="335" loading="lazy">
      </div>
    {%- endif -%}
  </div>
</quiz-section>

{% schema %}
{
  "name": "Quiz Section",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Text Content"
    },
    {
      "type": "text",
      "id": "heading_text",
      "label": "Heading text",
      "default": "Find Your Right Product:"
    },
    {
      "type": "text",
      "id": "prefix_text",
      "label": "Prefix text (before first dropdown)",
      "default": "I have"
    },
    {
      "type": "text",
      "id": "middle_text",
      "label": "Middle text (between dropdowns)",
      "default": "& I 'm looking for"
    },
    {
      "type": "header",
      "content": "Dropdown 1"
    },
    {
      "type": "text",
      "id": "dropdown1_placeholder",
      "label": "Dropdown 1 placeholder",
      "default": "skin type"
    },
    {
      "type": "text",
      "id": "dropdown1_options",
      "label": "Dropdown 1 options",
      "default": "Oily,Dry,Combination,Sensitive,Normal",
      "info": "Separate each option with a comma"
    },
    {
      "type": "header",
      "content": "Dropdown 2"
    },
    {
      "type": "text",
      "id": "dropdown2_placeholder",
      "label": "Dropdown 2 placeholder",
      "default": "product type"
    },
    {
      "type": "text",
      "id": "dropdown2_options",
      "label": "Dropdown 2 options",
      "default": "Moisturizer,Cleanser,Serum,Sunscreen,Toner",
      "info": "Separate each option with a comma"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "START QUIZ"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "image_picker",
      "id": "right_image",
      "label": "Right side image (desktop)"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Button image (mobile)"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Quiz Section"
    }
  ]
}
{% endschema %}
